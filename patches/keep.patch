+#[cfg(test)]
+mod frost_refresh_export_tests {
+    use super::import_teardown_tests::MemStorage;
+    use super::*;
+
+    const OLD: &str = "old-rotation-pass-1";
+    const NEW: &str = "new-rotation-pass-2";
+
+    fn decrypt(result: &FrostGenerationResult, passphrase: &str) -> Vec<SharePackage> {
+        result
+            .shares
+            .iter()
+            .map(|s| ShareExport::parse(&s.export_data).unwrap().to_share(passphrase, "rot").unwrap())
+            .collect()
+    }
+
+    #[test]
+    fn refresh_keeps_group_key_replaces_every_share_and_refuses_bad_sets() {
+        let mobile = KeepMobile::new(Arc::new(MemStorage::default())).unwrap();
+        let original = mobile.frost_generate(2, 3, "rot".into(), OLD.into()).unwrap();
+        let old: Vec<String> = original.shares.iter().map(|s| s.export_data.clone()).collect();
+        let old_pass = |n: usize| vec![OLD.to_string(); n];
+
+        let refreshed = mobile
+            .frost_refresh_exports(old.clone(), old_pass(3), "rot".into(), NEW.into())
+            .unwrap();
+        assert_eq!(refreshed.group_pubkey, original.group_pubkey);
+
+        let (before, after) = (decrypt(&original, OLD), decrypt(&refreshed, NEW));
+        for (b, a) in before.iter().zip(&after) {
+            assert_eq!(b.metadata.identifier, a.metadata.identifier);
+            assert_ne!(
+                b.key_package().unwrap().signing_share().serialize(),
+                a.key_package().unwrap().signing_share().serialize()
+            );
+        }
+        keep_core::frost::sign_with_local_shares(&after[1..], b"rotated").unwrap();
+
+        let refuse = |shares: Vec<String>, passes: Vec<String>| {
+            mobile.frost_refresh_exports(shares, passes, "rot".into(), NEW.into()).is_err()
+        };
+        assert!(refuse(old[..2].to_vec(), old_pass(2)), "partial set");
+        assert!(refuse(vec![old[0].clone(), old[0].clone(), old[1].clone()], old_pass(3)), "duplicate");
+        let mixed = vec![old[0].clone(), old[1].clone(), refreshed.shares[2].export_data.clone()];
+        assert!(refuse(mixed, vec![OLD.into(), OLD.into(), NEW.into()]), "old and new shares mixed");
+        // Legacy exports carry no authenticated member list; even the full set is refused.
+        let legacy: Vec<String> = old
+            .iter()
+            .map(|s| {
+                let mut e = ShareExport::parse(s).unwrap();
+                e.encrypted_pubkey_package = None;
+                e.pubkey_nonce = None;
+                e.encrypted_verifying_shares = None;
+                e.verifying_shares_nonce = None;
+                e.to_json().unwrap()
+            })
+            .collect();
+        let err = mobile
+            .frost_refresh_exports(legacy, old_pass(3), "rot".into(), NEW.into())
+            .unwrap_err();
+        assert!(format!("{err:?}").contains("re-export"), "{err:?}");
+    }
+}
